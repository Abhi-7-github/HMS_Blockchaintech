PORT=5000
MONGODB_URI=mongodb+srv://user:pass@cluster0.mongodb.net/dbname

APP_NAME=AmedicK

# Email configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM="AmedicK" <your_email@gmail.com>

# Security & Validation Config
BCRYPT_SALT_ROUNDS=10
PASSWORD_MIN_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_EXPIRE_SECONDS=600
ALLOWED_SELF_REGISTER_ROLES=PATIENT,DOCTOR

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d

# Cloudinary Storage Configuration (DO NOT expose API_SECRET to frontend)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=amedick/doctor-certificates
MAX_CERTIFICATE_FILE_SIZE_BYTES=5242880
